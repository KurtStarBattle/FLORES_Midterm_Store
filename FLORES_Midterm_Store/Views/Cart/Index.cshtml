@model List<FLORES_Midterm_Store.Models.CartItem>

@{ ViewData["Title"] = "Cart"; }


<h1>Cart</h1>

<form asp-action="Index" method="get" class="mb-3">
    <input type="text" name="searchString" value="@ViewData["searchString"]"
           placeholder="Search product name..." />
    <button type="submit">Search</button>
    <a asp-action="Index">Clear</a>
</form>

<table class="table table-bordered">
    <thead>
        <tr>
            <th>Id</th>
            <th>Product Name</th>
            <th>Price</th>
            <th>Quantity</th>
            <th>Subtotal</th>
            <th>Actions</th>
        </tr>
    </thead>
    <tbody>
        @foreach (var item in Model)
        {
            <tr>
                <td>@item.Id</td>
                <td>@item.ProductName</td>
                <td>₱@item.Price</td>
                <td>
                    <form asp-action="Update" method="post">
                        <input type="hidden" name="id" value="@item.Id" />
                        <input type="number" name="quantity" value="@item.Quantity" min="1"
                               class="form-control" style="width: 80px;" />
                        <button type="submit" class="btn btn-sm btn-primary mt-1">Update</button>
                    </form>
                </td>
                <td>₱@(item.Price * item.Quantity)</td>
                <td>
                    <a asp-action="Delete"
                       asp-route-id="@item.Id"
                       class="btn btn-sm btn-danger"
                       onclick="return confirm('Remove this item from the cart?')">
                        Remove
                    </a>
                </td>
            </tr>
        }
    </tbody>
</table>

<h4 class="text-end">
    Subtotal: ₱@Model.Sum(item => item.Price * item.Quantity)
</h4>

<a asp-controller="Products" asp-action="Index" class="btn btn-secondary">Back to Products</a>